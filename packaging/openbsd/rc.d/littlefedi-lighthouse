#!/bin/ksh
#
# Install as /etc/rc.d/littlefedi_lighthouse

daemon="/usr/local/bin/littlefedi"
daemon_flags="--config /etc/littlefedi/lighthouse.toml lighthouse"
daemon_user="_littlefedi_lighthouse"
daemon_class="littlefedi"
daemon_logger="daemon.info"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_start() {
	rc_exec "umask 0077; exec ${daemon} ${daemon_flags}"
}

rc_cmd $1

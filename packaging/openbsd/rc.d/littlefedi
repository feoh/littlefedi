#!/bin/ksh
#
# Needs a "littlefedi" class in /etc/login.conf.

daemon="/usr/local/bin/littlefedi"
daemon_flags="--config /etc/littlefedi/littlefedi.toml"
daemon_user="_littlefedi"
daemon_class="littlefedi"
daemon_logger="daemon.info"

daemon_envfile="/etc/littlefedi/littlefedi.env"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_start() {
	rc_exec "umask 0077; \
		if [ -r ${daemon_envfile} ]; then \
			set -a; . ${daemon_envfile}; set +a; \
		fi; \
		exec ${daemon} ${daemon_flags}"
}

rc_cmd $1

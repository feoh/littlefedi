[Unit]
Description=littleMesh lighthouse (relay for littleFedi instances behind NAT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=littlefedi-lighthouse
Group=littlefedi-lighthouse
WorkingDirectory=/var/lib/littlefedi-lighthouse
ExecStart=/usr/local/bin/littlefedi --config /etc/littlefedi/lighthouse.toml lighthouse
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
LimitNOFILE=65536
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/littlefedi-lighthouse

[Install]
WantedBy=multi-user.target
